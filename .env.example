NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PROJECT_ID=your-project-id

# Optional scheduled job protection
CRON_SECRET=replace-with-a-random-secret

# OpenClaw external scheduler API key
OPENCLAW_API_KEY=replace-with-a-random-secret

# Telegram parent channel
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token

# Platform credentials encryption: derived from SUPABASE_SERVICE_ROLE_KEY internally
# No separate PLATFORM_CREDENTIALS_ENCRYPTION_KEY needed.

# Supabase service role key (required for platform credentials encryption + voice file signed URLs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI API (for English reading content generation)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_READING_MODEL=gpt-4o-mini

# MiniMax daily image generation quota (cover images)
MINIMAX_DAILY_QUOTA=50

# Pipeline default grades to generate (comma-separated)
PIPELINE_GRADES=3,6

# Topics to process per pipeline run (0 = all topics)
PIPELINE_TOPIC_LIMIT=0

# Azure Speech Service for Chinese read-along audio (W0b feature)
# Get key from https://portal.azure.com → Cognitive Services → Speech
# Leave empty to disable audio synthesis (the pipeline will skip cleanly)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
