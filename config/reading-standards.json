  "english": {
    "_comment": "Use 'levels' (L1-L3) for new content. Retained for backward compatibility.",
    "1":  { "razLevel": "C-E", "wordCountMin": 50,   "wordCountMax": 180,  "wpm": 45,  "lexileScore": 200,  "chapterCount": 1, "questionsPerChapter": 5, "wordsPerChapter": { "min": 50, "max": 180 }, "blooms": { "literal": 5, "infer": 0, "evaluate": 0, "synthesize": 0 }, "syntax": { "simple": 80, "compound": 20, "complex": 0 }, "vocab": "GSL 1k only. Simple high-frequency words only.", "paragraphSentencesMin": 3, "paragraphSentencesMax": 4, "allowOpinion": false, "themeWords": 3 },
    "2":  { "razLevel": "F-H", "wordCountMin": 130,  "wordCountMax": 340,  "wpm": 75,  "lexileScore": 450,  "chapterCount": 1, "questionsPerChapter": 5, "wordsPerChapter": { "min": 130, "max": 340 }, "blooms": { "literal": 4, "infer": 1, "evaluate": 0, "synthesize": 0 }, "syntax": { "simple": 75, "compound": 25, "complex": 0 }, "vocab": "GSL 1k-2k only. Simple high-frequency words. Introduce basic compound sentences.", "paragraphSentencesMin": 3, "paragraphSentencesMax": 4, "allowOpinion": false, "themeWords": 4 },
    "3":  { "razLevel": "I-K", "wordCountMin": 350,  "wordCountMax": 550,  "wpm": 105, "lexileScore": 700,  "chapterCount": 1, "questionsPerChapter": 5, "wordsPerChapter": { "min": 350, "max": 550 }, "blooms": { "literal": 4, "infer": 1, "evaluate": 0, "synthesize": 0 }, "syntax": { "simple": 70, "compound": 30, "complex": 0 }, "vocab": "GSL 1k-2k only. Use only simple, high-frequency words. Avoid idioms, metaphors, and abstract vocabulary.", "paragraphSentencesMin": 3, "paragraphSentencesMax": 4, "allowOpinion": false, "themeWords": 4 },
    "4":  { "razLevel": "L-N", "wordCountMin": 450,  "wordCountMax": 800,  "wpm": 135, "lexileScore": 1000, "chapterCount": 3, "questionsPerChapter": 2, "wordsPerChapter": { "min": 150, "max": 270 }, "blooms": { "literal": 2, "infer": 2, "evaluate": 1, "synthesize": 0 }, "syntax": { "simple": 30, "compound": 40, "complex": 30 }, "vocab": "GSL 0-3k + AWL 1-5. Introduce some academic vocabulary. Use common idioms and simple metaphors.", "paragraphSentencesMin": 4, "paragraphSentencesMax": 7, "allowOpinion": false, "themeWords": 10 },
    "5":  { "razLevel": "O-Q", "wordCountMin": 600,  "wordCountMax": 1100, "wpm": 165, "lexileScore": 930,  "chapterCount": 4, "questionsPerChapter": 2, "wordsPerChapter": { "min": 150, "max": 275 }, "blooms": { "literal": 1, "infer": 2, "evaluate": 2, "synthesize": 0 }, "syntax": { "simple": 25, "compound": 45, "complex": 30 }, "vocab": "GSL 0-3k + AWL 1-5. Introduce some academic vocabulary. Use common idioms and simple metaphors.", "paragraphSentencesMin": 4, "paragraphSentencesMax": 7, "allowOpinion": false, "themeWords": 10 },
    "6":  { "razLevel": "R-T", "wordCountMin": 700,  "wordCountMax": 1500, "wpm": 180, "lexileScore": 1035, "chapterCount": 4, "questionsPerChapter": 2, "wordsPerChapter": { "min": 175, "max": 375 }, "blooms": { "literal": 0, "infer": 2, "evaluate": 2, "synthesize": 1 }, "syntax": { "simple": 20, "compound": 45, "complex": 35 }, "vocab": "GSL 0-3k + AWL 1-5. Use common idioms and metaphors. Moderate academic vocabulary.", "paragraphSentencesMin": 4, "paragraphSentencesMax": 7, "allowOpinion": true, "themeWords": 12 },
    "7":  { "razLevel": "U-V", "wordCountMin": 900,  "wordCountMax": 1800, "wpm": 195, "lexileScore": 1115, "chapterCount": 5, "questionsPerChapter": 1, "wordsPerChapter": { "min": 180, "max": 360 }, "blooms": { "literal": 0, "infer": 2, "evaluate": 2, "synthesize": 1 }, "syntax": { "simple": 15, "compound": 45, "complex": 40 }, "vocab": "GSL full + AWL full + academic vocabulary. Use sophisticated figurative language, nuanced vocabulary, and rhetorical devices.", "paragraphSentencesMin": 5, "paragraphSentencesMax": 9, "allowOpinion": true, "themeWords": 14 },
    "8":  { "razLevel": "W-X", "wordCountMin": 1000, "wordCountMax": 2200, "wpm": 210, "lexileScore": 1202, "chapterCount": 5, "questionsPerChapter": 1, "wordsPerChapter": { "min": 200, "max": 440 }, "blooms": { "literal": 0, "infer": 2, "evaluate": 2, "synthesize": 1 }, "syntax": { "simple": 15, "compound": 45, "complex": 40 }, "vocab": "GSL full + AWL full + academic vocabulary. Use sophisticated figurative language, nuanced vocabulary, and rhetorical devices.", "paragraphSentencesMin": 5, "paragraphSentencesMax": 9, "allowOpinion": true, "themeWords": 14 },
    "9":  { "razLevel": "Y",   "wordCountMin": 1200, "wordCountMax": 2600, "wpm": 220, "lexileScore": 1295, "chapterCount": 6, "questionsPerChapter": 1, "wordsPerChapter": { "min": 200, "max": 434 }, "blooms": { "literal": 0, "infer": 1, "evaluate": 3, "synthesize": 2 }, "syntax": { "simple": 10, "compound": 40, "complex": 50 }, "vocab": "GSL full + AWL full + academic vocabulary. Use sophisticated figurative language, nuanced vocabulary, rhetorical devices, and domain-specific terminology.", "paragraphSentencesMin": 5, "paragraphSentencesMax": 9, "allowOpinion": true, "themeWords": 16 },
    "10": { "razLevel": "Z",   "wordCountMin": 1400, "wordCountMax": 3000, "wpm": 230, "lexileScore": 1380, "chapterCount": 6, "questionsPerChapter": 1, "wordsPerChapter": { "min": 234, "max": 500 }, "blooms": { "literal": 0, "infer": 1, "evaluate": 3, "synthesize": 2 }, "syntax": { "simple": 10, "compound": 40, "complex": 50 }, "vocab": "GSL full + AWL full + academic vocabulary. Use sophisticated figurative language, nuanced vocabulary, rhetorical devices, and domain-specific terminology.", "paragraphSentencesMin": 5, "paragraphSentencesMax": 9, "allowOpinion": true, "themeWords": 16 }
